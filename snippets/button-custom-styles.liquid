{% doc %}
  Outputs scoped CSS custom properties for the button-custom style class and
  direct color overrides for the button-unstyled (link) style.

  @param {object} block_settings - The block's settings object
  @param {string} block_id - The block ID used to scope the CSS

  @example
  {% render 'button-custom-styles', block_settings: block_settings, block_id: block.id %}
{% enddoc %}

{% if block_settings.style_class == 'button-unstyled' and block_settings.link_text_color != blank %}
  {% style %}
    .button-unstyled--{{ block_id }},
    .email-signup__button.button-unstyled.button-unstyled--{{ block_id }} {
      color: rgb({{ block_settings.link_text_color.rgba }});
    }

    .button-unstyled--{{ block_id }}:hover,
    .email-signup__button.button-unstyled.button-unstyled--{{ block_id }}:hover {
      color: rgb({{ block_settings.link_text_color.rgb }} / var(--opacity-70));
    }
  {% endstyle %}
{% endif %}

{%- liquid
  comment
    The trailing icon defaults to the arrow so every button saved before icon_style
    existed keeps the glyph it already had.

    icon-arrow-top-right.svg draws a 12px glyph inside a padded 24px viewBox, so its
    mask is pinned to 24px and the 15px box crops the padding away. icon-download.svg
    fills its 18px viewBox edge to edge, so it is masked and boxed at its native size —
    the 18px the design calls for.
  endcomment

  assign icon_style = block_settings.icon_style | default: 'arrow'
  if icon_style == 'download'
    assign icon_url = 'icon-download.svg' | asset_url
    assign icon_box = 18
    assign icon_mask_size = '18px 18px'
  else
    assign icon_url = 'icon-arrow-top-right.svg' | asset_url
    assign icon_box = 15
    assign icon_mask_size = '24px 24px'
  endif
-%}

{% if block_settings.pill or block_settings.show_arrow_icon %}
  {% style %}
    {% if block_settings.pill %}
      .{{ block_settings.style_class }}.{{ block_settings.style_class }}--{{ block_id }} {
        border-radius: 80px;
      }
    {% endif %}
    {% if block_settings.show_arrow_icon %}
      .{{ block_settings.style_class }}.{{ block_settings.style_class }}--{{ block_id }} {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        {%- comment -%}
          Every Figma button component sets the label to nowrap. It matters most here:
          once the label breaks over two lines the trailing icon is left stranded beside
          a stack of text, which is never what the icon variant is drawn as.
        {%- endcomment -%}
        white-space: nowrap;
      }

      .{{ block_settings.style_class }}.{{ block_settings.style_class }}--{{ block_id }}::after {
        content: '';
        flex-shrink: 0;
        width: {{ icon_box }}px;
        height: {{ icon_box }}px;
        background-color: currentcolor;
        mask: url('{{ icon_url }}') center / {{ icon_mask_size }} no-repeat;
        transition: var(--button-arrow-transition);
      }

      {%- if icon_style == 'download' -%}
        {%- comment -%}
          The download glyph already points down, so it nudges along its own axis rather
          than swinging round like the arrow. Shared timing, different gesture.
        {%- endcomment -%}
        .{{ block_settings.style_class }}.{{ block_settings.style_class }}--{{ block_id }}:hover::after {
          transform: translate(0, 2px);
        }
      {%- else -%}
        {%- comment -%}
          Shared trailing-arrow motion — see theme-styles-variables. This is the generic
          show_arrow_icon path, so every current and future block that opts into the arrow
          gets the swing without restating it.
        {%- endcomment -%}
        .{{ block_settings.style_class }}.{{ block_settings.style_class }}--{{ block_id }}:hover::after {
          transform: var(--button-arrow-hover-transform);
        }
      {%- endif -%}
    {% endif %}
  {% endstyle %}
{% endif %}

{% if block_settings.style_class == 'button-custom' %}
  {%- assign effective_background_color = block_settings.custom_button_background
    | default: settings.palette_primary_button_background
  %}
  {%- assign effective_text_color = block_settings.custom_button_text
    | default: settings.palette_primary_button_text
  -%}
  {%- assign effective_border_color = block_settings.custom_button_border
    | default: settings.palette_primary_button_border
  -%}
  {%- comment -%}
    base.css draws .button-custom's border with `outline` and colours it from
    --button-focus-outline-color, so this is the ring at rest every bit as much as on focus.
    A button with a background can fall back to that background. A transparent one has
    nothing behind the ring, so it follows the border colour instead — on an outline button
    the ring is the border, and taking the text colour here painted it white over whatever
    the merchant had set.
  {%- endcomment -%}
  {%- if effective_background_color.alpha == 0 -%}
    {%- assign effective_focus_outline_color = effective_border_color -%}
  {%- else -%}
    {%- assign effective_focus_outline_color = effective_background_color -%}
  {%- endif -%}
  {%- capture hover_resolved -%}
    {% render 'resolve-custom-hover',
      base_bg: effective_background_color,
      base_text: effective_text_color,
      base_border: effective_border_color
    %}
  {%- endcapture -%}
  {%- assign hover_parts = hover_resolved | strip | split: '||' -%}
  {%- assign effective_hover_bg = hover_parts[0] -%}
  {%- assign effective_hover_text = hover_parts[1] -%}
  {%- assign effective_hover_border = hover_parts[2] -%}
  {% style %}
    .button-custom--{{ block_id }} {
      --button-background-color: rgb({{ effective_background_color.rgba }});
      --button-color: rgb({{ effective_text_color.rgba }});
      --button-border-color: rgb({{ effective_border_color.rgba }});
      --button-focus-outline-color: rgb({{ effective_focus_outline_color.rgb }});
      {%- comment -%}
        Feed the radial hover fill in base.css: it paints the resolved hover
        colour over whatever --button-fill-under leaves beneath it. Same alpha
        test resolve-custom-hover uses — a translucent fill has to clear the
        idle colour out or the two composite into something too strong, while an
        opaque one hides it and so wants it held steady.
      {%- endcomment -%}
      --button-fill-color: {{ effective_hover_bg }};
      {%- if effective_background_color.alpha == 1 %}
      --button-fill-under: rgb({{ effective_background_color.rgba }});
      {%- else %}
      --button-fill-under: transparent;
      {%- endif %}
    }
    .button-custom--{{ block_id }}:hover {
      --button-background-color: {{ effective_hover_bg }};
      --button-color: {{ effective_hover_text }};
      --button-border-color: {{ effective_hover_border }};
    }
  {% endstyle %}
{% endif %}
