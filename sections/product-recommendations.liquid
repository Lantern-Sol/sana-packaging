<script
  src="{{ 'product-recommendations.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  case section.settings.layout_type
    when 'grid'
      assign classes = 'resource-list--grid'
    when 'carousel'
      assign classes = 'resource-list__carousel'
  endcase

  capture styles
    echo '--column-count-mobile: ' | append: section.settings.mobile_columns | append: ';'
    echo '--resource-list-column-gap-desktop: ' | append: section.settings.columns_gap | append: 'px;'
    echo '--resource-list-row-gap-desktop: ' | append: section.settings.rows_gap | append: 'px;'
    echo '--resource-list-columns: repeat(' | append: section.settings.columns | append: ', 1fr);'
    echo '--resource-list-columns-mobile: repeat(' | append: section.settings.mobile_columns | append: ', 1fr);'
    echo '--resource-list-column-gap-desktop: ' | append: section.settings.columns_gap | append: 'px;'
    echo '--column-count: ' | append: section.settings.columns | append: ';'
    echo '--column-count-mobile: ' | append: section.settings.mobile_columns | append: ';'
  endcapture
%}

{% render 'quick-add-styles' %}
{% render 'quick-add-modal-styles' %}
{% render 'variant-picker-styles' %}
{% render 'product-badges-styles' %}
<product-recommendations
  id="product-recommendations-{{ section.id }}"
  class="product-recommendations product-recommendations--sana"
  data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.max_products }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ section.settings.product.id | default: product.id }}"
  data-intent="{{ section.settings.recommendation_type }}"
  data-testid="product-recommendations-section"
  data-recommendations-performed="{{ recommendations.performed }}"
  data-hydration-key="product-recommendations-{{ section.id }}"
  {{ section.shopify_attributes }}
>
  {% liquid
    if section.settings.background_color != blank
      render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
    endif
  %}

  <div
    class="section-background product-recommendations__background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
    style="{% if section.settings.background_image != blank %}--recommendations-texture: url('{{ section.settings.background_image | image_url: width: 2400 }}');{% endif %}"
  ></div>
  <div
    class="
      section
      section--{{ section.settings.section_width }}
      {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
      section-resource-list
      spacing-style
      gap-style
    "
    style="
      {%  render 'spacing-style', settings: section.settings %}
      {%  render 'gap-style', value: section.settings.gap %}
      {{ styles }}
    "
  >
    <div class="section-resource-list__content">
      {% content_for 'blocks' %}
    </div>

    {%- if recommendations.performed or section.settings.product == blank -%}
      {% liquid
        if section.settings.product == blank
          assign products = null
          # Onboarding mode: Show placeholder products
          for i in (1..section.settings.max_products)
            assign products = products | append: ', '
            assign products = products | split: ','
          endfor
        elsif recommendations.performed and recommendations.products_count == 0
          # No recommendations found, pull from catalog
          if section.settings.recommendation_type == 'related'
            assign products = collections.all.products | reject: 'id', section.settings.product.id
          elsif section.settings.recommendation_type == 'complementary'
            # Do not recommend the All collection as complementary products
            assign products = null
          endif

        else
          assign products = recommendations.products
        endif
      %}
      {% capture list_items %}
        {% for product in products limit: section.settings.max_products %}
          <div class="resource-list__item">
            {% content_for 'block',
              type: '_product-card',
              id: 'static-product-card',
              closest.product: product,
              product_view_context: 'recommendation'
            %}
          </div>
          {% unless forloop.last %}
            <!--@list/split-->
          {% endunless %}
        {% endfor %}
      {% endcapture %}

      {% liquid
        # Create an array from the list items to be used in the carousel
        assign slide_content = list_items | strip
        assign slides = slide_content | split: '<!--@list/split-->'

        if products != blank and products.size > 0
          assign has_recommendations = 'true'
        else
          assign has_recommendations = 'false'
        endif
      %}

      <div
        class="
          resource-list
          {% if section.settings.layout_type == 'carousel' %}
            force-full-width
          {% endif %}
          {% if section.settings.carousel_on_mobile and section.settings.layout_type != 'carousel' %}
            hidden--mobile
          {% endif %}
          {{ classes }}
        "
        {% if section.settings.layout_type == 'grid' %}
          data-testid="resource-list-grid"
        {% endif %}
        data-has-recommendations="{{ has_recommendations }}"
      >
        {% case section.settings.layout_type %}
          {% when 'grid' %}
            {{ list_items }}
          {% when 'carousel' %}
            {% render 'resource-list-carousel',
              ref: 'resourceListCarousel',
              slides: slides,
              slide_count: recommendations.products.size,
              settings: section.settings
            %}
        {% endcase %}
      </div>

      {% if section.settings.carousel_on_mobile and section.settings.layout_type != 'carousel' %}
        {% liquid
          assign mobile_carousel_gap = section.settings.columns_gap
        %}
        <div
          class="
            resource-list
            hidden--desktop
            force-full-width
          "
          style="
            --resource-list-gap: {{ mobile_carousel_gap }}px;
            --column-count: {{ section.settings.columns }};
          "
        >
          {% render 'resource-list-carousel',
            ref: 'resourceListCarouselMobile',
            slides: slides,
            slide_count: recommendations.products.size,
            settings: section.settings
          %}
        </div>
      {% endif %}
    {%- else -%}
      <div
        class="resource-list resource-list--grid"
      >
        {% for i in (1..section.settings.columns) %}
          <div
            class="product-recommendations__skeleton-item"
            aria-label="{{ 'accessibility.loading_product_recommendations' | t }}"
          ></div>
        {% endfor %}
      </div>
    {%- endif -%}
  </div>
</product-recommendations>

{% stylesheet %}
  .product-recommendations--sana {
    --recommendations-card: #064c4d;
    --recommendations-accent: #7ce5cc;
    --recommendations-deep: #023031;
    color: #fff;
  }

  .product-recommendations--sana .product-recommendations__background {
    background-color: #064c4d;
    background-image: var(--recommendations-texture), linear-gradient(186deg, #42a899 2%, #146b68 30%, #064c4d 57%, #023031 97%);
    background-position: center;
    background-size: cover;
    background-blend-mode: multiply, normal;
  }

  .product-recommendations--sana .section-resource-list {
    padding-block: clamp(72px, 8.333vw, 120px);
    row-gap: 48px;
  }

  .product-recommendations--sana .section-resource-list__content {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .product-recommendations--sana .section-resource-list__content h2 {
    margin: 0;
    color: #fff;
    font-family: var(--font-primary--family);
    font-size: clamp(28px, 2.5vw, 36px);
    font-weight: 600;
    line-height: 1.2;
  }

  .product-recommendations--sana .section-resource-list__content .button {
    min-height: 48px;
    padding: 12px 28px;
    border: 1px solid #fff;
    border-radius: 80px;
    color: #fff;
    background: transparent;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: .02em;
  }

  .product-recommendations--sana .resource-list__carousel {
    --slide-width-max: none !important;
  }

  .product-recommendations--sana .resource-list__carousel slideshow-slides {
    gap: 32px;
  }

  .product-recommendations--sana .resource-list__slide {
    --slide-width: calc((100% - 96px) / 4);
  }

  .product-recommendations--sana .product-card {
    overflow: hidden;
    border-radius: 24px;
    color: #fff;
    background: var(--recommendations-card);
  }

  .product-recommendations--sana .product-card__content {
    position: relative;
    gap: 0;
    padding: 0 0 24px;
    background: var(--recommendations-card);
  }

  .product-recommendations--sana .product-card__content > .card-gallery {
    overflow: hidden;
    aspect-ratio: 400 / 500;
    border-radius: 24px 24px 0 0;
  }

  .product-recommendations--sana .card-gallery::after {
    content: '';
    position: absolute;
    inset: 28% 0 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(to bottom, transparent, rgb(20 107 104 / .9));
  }

  .product-recommendations--sana .card-gallery img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The title block is wrapped in <a class="contents">, so it is a GRANDCHILD of
     .product-card__content. The previous direct-child selector never matched, which left
     the title inheriting the section's dark foreground — dark text on the dark scrim. */
  /* The wrapper <a class="contents"> is display:contents and generates no box, so the
     .text-block itself has to carry the positioning. */
  .product-recommendations--sana .product-card__content > a.contents > .text-block {
    position: absolute;
    z-index: 3;
    left: 24px;
    right: 24px;
    bottom: 127px;
    width: auto;
    margin: 0;
    pointer-events: none;
  }

  .product-recommendations--sana .product-card__content > a.contents > .text-block,
  .product-recommendations--sana .product-card__content > a.contents > .text-block :is(h2, h3, h4, p) {
    color: #fff;
    font-family: var(--font-heading--family);
    font-size: 24px;
    font-weight: 600;
    line-height: 1.25;
  }

  /* Figma shows "View Product" permanently beneath the title; the theme default reveals it
     on hover only (opacity: 0). */
  /* Anchored to the gallery box, whose lower edge is where the buy bar begins — so this
     lands directly under the title rather than above it. */
  .product-recommendations--sana .card-media-actions {
    position: absolute;
    z-index: 4;
    inset: auto 24px 12px;
    display: block;
    justify-content: flex-start;
  }

  .product-recommendations--sana .card-media-actions .card-media-actions__view {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 0;
    padding: 0;
    border: 0;
    opacity: 1;
    color: #fff;
    background: transparent;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0;
    transform: none;
  }

  .product-recommendations--sana .product-card__content > .buy-buttons-block {
    display: block;
    width: 100%;
    margin-top: 24px;
    padding-inline: 16px;
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .product-recommendations--sana .buy-buttons-block product-form-component,
  .product-recommendations--sana .buy-buttons-block .shopify-product-form {
    display: block;
    width: 100%;
  }

  .product-recommendations--sana .buy-buttons-block .product-form-buttons {
    display: grid;
    grid-template-columns: minmax(96px, .8fr) minmax(140px, 1.2fr);
    gap: 16px;
    width: 100%;
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .product-recommendations--sana .buy-buttons-block .quantity-selector {
    min-height: 40px;
    height: 40px;
    border-color: var(--recommendations-accent);
    border-radius: 24px;
    color: #fff;
    background: transparent;
  }

  .product-recommendations--sana .buy-buttons-block add-to-cart-component,
  .product-recommendations--sana .buy-buttons-block .add-to-cart-button {
    display: flex;
    width: 100%;
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .product-recommendations--sana .buy-buttons-block .add-to-cart-button {
    min-height: 40px;
    height: 40px;
    border-color: var(--recommendations-accent);
    border-radius: 80px;
    color: var(--recommendations-deep);
    background: var(--recommendations-accent);
    font-size: 14px;
  }

  .product-recommendations--sana .card-media-actions {
    inset-inline: 24px;
    bottom: 24px;
    z-index: 3;
    justify-content: flex-start;
  }

  .product-recommendations--sana .card-media-actions__view {
    padding: 0;
    border: 0;
    color: #fff;
    background: transparent;
    font-size: 14px;
  }

  .product-recommendations--sana .resource-list__carousel slideshow-component {
    padding-bottom: 87px;
  }

  .product-recommendations--sana .resource-list__carousel slideshow-container {
    overflow: visible;
  }

  .product-recommendations--sana .resource-list__carousel slideshow-arrows {
    position: absolute;
    inset: calc(100% + 32px) auto auto 0;
    display: flex;
    width: 122px;
    height: 55px;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    padding: 0;
    z-index: var(--layer-raised);
    pointer-events: none;
    mix-blend-mode: normal;
  }

  .product-recommendations--sana slideshow-arrows .slideshow-control {
    position: static;
    width: 55px;
    height: 55px;
    border: 0;
    border-radius: 50%;
    color: #fff;
    background: rgb(43 139 131 / .5);
    opacity: 1;
  }

  .product-recommendations--sana slideshow-arrows .slideshow-control[disabled] {
    display: flex;
    opacity: .45;
  }

  @media screen and (max-width: 989px) {
    .product-recommendations--sana .resource-list__slide { --slide-width: calc((100% - 32px) / 2.25); }
  }

  @media screen and (max-width: 749px) {
    .product-recommendations--sana .section-resource-list { padding-block: 64px; row-gap: 32px; }
    .product-recommendations--sana .section-resource-list__content { align-items: flex-start; flex-direction: column; }
    .product-recommendations--sana .resource-list__carousel slideshow-slides { gap: 16px; }
    .product-recommendations--sana .resource-list__slide { --slide-width: min(82vw, 344px); }
    .product-recommendations--sana .product-card__content > .text-block { bottom: 100px; }
    .product-recommendations--sana .product-card__content > .text-block :is(h2, h3, h4, p, a) { font-size: 20px; }
    .product-recommendations--sana .buy-buttons-block .product-form-buttons { grid-template-columns: minmax(88px, .8fr) minmax(132px, 1.2fr); gap: 12px; }
    .product-recommendations--sana .resource-list__carousel slideshow-component { padding-bottom: 72px; }
    .product-recommendations--sana .resource-list__carousel slideshow-arrows { inset-block-start: calc(100% + 24px); width: 108px; height: 48px; }
    .product-recommendations--sana slideshow-arrows .slideshow-control { width: 48px; height: 48px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_recommendations",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    }
  ],
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product"
    },
    {
      "type": "select",
      "id": "recommendation_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "related",
          "label": "t:options.related"
        },
        {
          "value": "complementary",
          "label": "t:options.complementary"
        }
      ],
      "default": "related"
    },
    {
      "type": "paragraph",
      "content": "t:content.complementary_products"
    },
    {
      "type": "header",
      "content": "t:content.cards_layout"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.layout_style",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "t:settings.carousel_on_mobile",
      "default": false,
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.product_count",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "t:options.one_number"
        },
        {
          "value": "2",
          "label": "t:options.two_number"
        }
      ],
      "default": "2",
      "visible_if": "{{ section.settings.layout_type == 'grid' and section.settings.carousel_on_mobile == false }}"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.layout_type == 'grid' or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "header",
      "content": "t:content.carousel_navigation",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "arrows_large",
          "label": "t:options.arrows_large"
        },
        {
          "value": "chevron_large",
          "label": "t:options.chevron_large"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "t:settings.icon_background",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "circle",
          "label": "t:options.circle"
        },
        {
          "value": "square",
          "label": "t:options.square"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.icons_style != 'none' and section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Displayed over the teal gradient to match the design."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "checkbox",
      "id": "use_mobile_padding",
      "label": "Use mobile padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.use_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.use_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.product_recommendations",
      "category": "t:categories.products",
      "settings": {
        "product": "{{ closest.product }}",
        "recommendation_type": "related",
        "layout_type": "grid",
        "carousel_on_mobile": false,
        "max_products": 4,
        "columns": 4,
        "mobile_columns": "2",
        "columns_gap": 12,
        "rows_gap": 24,
        "icons_style": "arrow",
        "icons_shape": "none",
        "section_width": "page-width",
        "gap": 28,
        "padding-block-start": 48,
        "padding-block-end": 48
      },
      "blocks": {
        "header": {
          "type": "text",
          "name": "t:names.header",
          "settings": {
            "text": "t:html_defaults.related_product",
            "type_preset": "h3"
          }
        },
        "static-product-card": {
          "type": "_product-card",
          "name": "t:names.product_card",
          "static": true,
          "settings": {
            "product_card_gap": 4
          },
          "blocks": {
            "product-card-gallery": {
              "type": "_product-card-gallery",
              "name": "t:names.product_card_media",
              "settings": {
                "image_ratio": "adapt",
