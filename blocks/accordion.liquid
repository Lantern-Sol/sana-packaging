{% assign block_settings = block.settings %}

{%- capture accordion_rows -%}
  {% content_for 'blocks' %}
{%- endcapture -%}

{% liquid
  # Rows remove themselves when the product has nothing to put in them. Once every row has
  # gone the wrapper would still paint its dividers, border and padding around nothing, so
  # the accordion goes with them. The editor always renders, so rows stay reachable there.
  assign accordion_rows_stripped = accordion_rows | strip

  assign render_accordion = false
  if accordion_rows_stripped != blank or request.design_mode or request.visual_preview_mode
    assign render_accordion = true
  endif
%}

{%- if render_accordion -%}
{% render 'contrast-override',
  background_color: block_settings.background_color,
  text_color: block_settings.text_color,
  section_id: block.id
%}

<div
  class="accordion accordion--{{ block.id }} accordion--{{ block_settings.icon }} border-style spacing-style{% if block_settings.background_color != blank or block_settings.text_color != blank %} color-custom-{{ block.id }}{% endif %}{% if block_settings.background_color != blank %} accordion--custom-background{% endif %}{% if block_settings.dividers %} accordion--dividers{% endif %}{% if block_settings.row_style == 'cards' %} accordion--cards{% endif %}"
  style="
    {%- if block_settings.row_style == 'cards' -%}
      --accordion-row-background: {{ block_settings.row_background_color | default: 'transparent' }};
      --accordion-row-radius: {{ block_settings.row_corner_radius }}px;
      --accordion-row-padding: {{ block_settings.row_padding }}px;
      --accordion-row-padding-mobile: {{ block_settings.row_padding_mobile }}px;
      --accordion-row-gap: {{ block_settings.row_gap }}px;
      --accordion-row-inner-gap: {{ block_settings.row_inner_gap }}px;
      --accordion-icon-size: {{ block_settings.icon_chip_size }}px;
      --accordion-icon-background: {{ block_settings.icon_chip_color | default: 'transparent' }};
      --accordion-caret-icon: url('{{ 'icon-caret-right.svg' | asset_url }}');
      {%- comment -%}
        The chip's default face is the two gradients from the design. A chosen icon background is
        a deliberate override, so it clears them rather than sitting invisible underneath.
      {%- endcomment -%}
      {%- if block_settings.icon_chip_color != blank -%}
        --accordion-icon-fill: none;
        --accordion-icon-border: none;
      {%- endif -%}
    {%- endif -%}
    --summary-font-family: var(--font-{{ block_settings.type_preset }}--family);
     --summary-font-style: var(--font-{{ block_settings.type_preset }}--style);
     --summary-font-weight: bold;
     --summary-font-size: var(--font-{{ block_settings.type_preset }}--size);
     --summary-font-line-height: var(--font-{{ block_settings.type_preset }}--line-height);
     --summary-font-case: var(--font-{{ block_settings.type_preset }}--case);
    {% render 'spacing-style', settings: block_settings %}
    {% render 'border-override', settings: block_settings %}
    {% if block_settings.divider_color != blank %} --color-border: {{ block_settings.divider_color }};{% endif %}
  "
  {{ block.shopify_attributes }}
>
  {{ accordion_rows }}
</div>

{% render 'accordion-styles' %}
{%- endif -%}

{% stylesheet %}
  /* Card rows: each row becomes its own surface instead of one divided list. */
  .accordion--cards {
    display: flex;
    flex-direction: column;
    gap: var(--accordion-row-gap);
  }

  .accordion--cards accordion-custom {
    display: block;
    padding: var(--accordion-row-padding);
    border-radius: var(--accordion-row-radius);
    background-color: var(--accordion-row-background);
  }

  /* The list style draws rules between rows, which would double up on the card edges.
     accordion-styles.liquid's between-row selectors tie on specificity and win on source
     order, so the class is repeated here to outrank them. */
  .accordion--cards.accordion--cards.accordion--dividers accordion-custom .details,
  .accordion--cards.accordion--cards.accordion--dividers accordion-custom:first-child .details,
  .accordion--cards.accordion--cards.accordion--dividers accordion-custom:last-child .details {
    border-block: none;
  }

  /* The summary carries its own block padding for the list style; under cards the card
     already supplies that, so it would double up. Class repeated to outrank the source rule. */
  .accordion--cards.accordion--cards .details__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--accordion-row-inner-gap);
    padding-block: 0;
  }

  /* Under cards, "dividers" means the rule between the question and its answer. */
  .accordion--cards.accordion--dividers .details[open] .details-content {
    margin-block-start: var(--accordion-row-inner-gap);
    padding-block-start: var(--accordion-row-inner-gap);
    border-block-start: 1px solid var(--color-border);
  }

  /*
    Chip face, from the design: a mint fill running up-left, ringed by a 1px gradient that
    deepens toward the bottom-right. Both are expressed against the artwork's 44px frame so
    the whole chip scales from the one size setting.
  */
  .accordion--cards {
    --accordion-icon-border-width: 1px;
    --accordion-icon-fill: linear-gradient(333.43deg, var(--color-teal-200) 0%, var(--color-teal-50) 94.44%);
    --accordion-icon-border: linear-gradient(158.45deg, var(--color-teal-200) 0%, var(--color-teal-400) 100%);
    --accordion-icon-color: var(--color-teal-500);
  }

  .accordion--cards .details__header :is(.icon-caret, .icon-plus) {
    position: relative;
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: var(--accordion-icon-size);
    height: var(--accordion-icon-size);
    border: var(--accordion-icon-border-width) solid transparent;
    border-radius: calc(var(--accordion-icon-size) * 10 / 44);
    background-color: var(--accordion-icon-background);
    background-image: var(--accordion-icon-fill), var(--accordion-icon-border);
    background-origin: border-box;
    /* Fill stops at the padding box, ring fills the border box — the standard gradient-border
       sandwich, which needs the transparent border above to leave the ring somewhere to paint. */
    background-clip: padding-box, border-box;
  }

  /*
    The design's chevron points right and swings down as the row opens, rather than the shared
    caret's down/up flip. It is painted as a mask so _accordion-row.liquid — which inlines the
    same icon-caret.svg for every accordion in the theme — needs no change.
  */
  .accordion--cards .details__header .icon-caret > svg {
    display: none;
  }

  .accordion--cards .details__header .icon-caret::after {
    content: '';
    /* Pulled out to the border box, since absolute insets resolve against the padding box.
       That maps the 44-unit artwork onto the chip 1:1 at the design's size. */
    position: absolute;
    inset: calc(-1 * var(--accordion-icon-border-width));
    background-color: var(--accordion-icon-color);
    mask: var(--accordion-caret-icon) center / 100% 100% no-repeat;
    transition: transform var(--animation-speed) var(--animation-easing);
  }

  .accordion--cards .details[open] .details__header .icon-caret::after {
    transform: rotate(90deg);
  }

  /* Both glyphs are always in the markup and accordion-styles hides the unused one; the
     chip rule above is more specific and would otherwise reveal both. */
  .accordion--cards.accordion--caret .details__header .icon-plus,
  .accordion--cards.accordion--plus .details__header .icon-caret {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .accordion--cards accordion-custom {
      padding: var(--accordion-row-padding-mobile);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.accordion",
  "tag": null,
  "class": "accordion",
  "blocks": [
    {
      "type": "_accordion-row"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "caret",
          "label": "t:options.caret"
        },
        {
          "value": "plus",
          "label": "t:options.plus"
        }
      ],
      "default": "caret"
    },
    {
      "type": "select",
      "id": "row_style",
      "label": "Row style",
      "info": "Cards give each row its own background and corner radius instead of one divided list.",
      "options": [
        {
          "value": "list",
          "label": "List"
        },
        {
          "value": "cards",
          "label": "Cards"
        }
      ],
      "default": "list"
    },
    {
      "type": "color",
      "id": "row_background_color",
      "label": "Row background",
      "default": "#ffffff",
      "visible_if": "{{ block.settings.row_style == 'cards' }}"
    },
    {
      "type": "range",
      "id": "row_corner_radius",
      "label": "Row corner radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 20,
      "visible_if": "{{ block.settings.row_style == 'cards' }}"
    },
    {
      "type": "range",
      "id": "row_padding",
      "label": "Row padding",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 32,
      "visible_if": "{{ block.settings.row_style == 'cards' }}"
    },
    {
      "type": "range",
      "id": "row_padding_mobile",
      "label": "Row padding (mobile)",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.row_style == 'cards' }}"
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Gap between rows",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.row_style == 'cards' }}"
    },
    {
      "type": "range",
      "id": "row_inner_gap",
      "label": "Gap between question and answer",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.row_style == 'cards' }}"
    },
    {
      "type": "color",
      "id": "icon_chip_color",
      "label": "Icon background",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.row_style == 'cards' }}"
    },
    {
      "type": "range",
      "id": "icon_chip_size",
      "label": "Icon size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 44,
      "visible_if": "{{ block.settings.row_style == 'cards' }}"
    },
    {
      "type": "checkbox",
      "id": "dividers",
      "label": "t:settings.dividers",
      "default": true
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.dividers }}"
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "t:settings.heading_preset",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "paragraph",
          "label": "t:options.paragraph"
        },
        {
          "value": "h1",
          "label": "t:options.h1"
        },
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        }
      ],
      "default": "h6",
      "info": "t:info.edit_presets_in_theme_settings"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.accordion",
      "category": "t:categories.layout",
      "blocks": {
        "row-1": {
          "type": "_accordion-row",
          "settings": {
            "open_by_default": true,
            "heading": "t:text_defaults.return_policy"
          },
          "blocks": {
            "text-1": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.goal_for_every_customer",
                "width": "100%"
              }
            }
          },
          "block_order": ["text-1"]
        },
        "row-2": {
          "type": "_accordion-row",
          "settings": {
            "heading": "t:text_defaults.shipping"
          },
          "blocks": {
            "text-1": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.work_quickly_to_ship",
                "width": "100%"
              }
            }
          },
          "block_order": ["text-1"]
        },
        "row-3": {
          "type": "_accordion-row",
          "settings": {
            "heading": "t:text_defaults.manufacturing"
          },
          "blocks": {
            "text-1": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.made_local_and_global",
                "width": "100%"
              }
            }
          },
          "block_order": ["text-1"]
        }
      },
      "block_order": ["row-1", "row-2", "row-3"]
    }
  ]
}
{% endschema %}
